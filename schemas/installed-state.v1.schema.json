{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appliance-release/schemas/installed-state.v1.schema.json",
  "title": "InstalledState",
  "description": "Atomic on-host journal record of the exact installed state, written after every lifecycle transaction. Backs status, verify, upgrade compatibility checks, and K3s ownership decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "applianceInstanceId",
    "installedVersion",
    "installedReleaseId",
    "components",
    "k3sOwnership",
    "lastOperation",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "applianceInstanceId": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for this host installation, generated on first install."
    },
    "installedVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "installedReleaseId": {
      "type": "string",
      "minLength": 1
    },
    "applianceProfile": {
      "type": "string",
      "enum": [
        "core",
        "builder",
        "storage",
        "landns",
        "storage-landns",
        "builder-landns",
        "builder-storage-landns",
        "lanllm",
        "builder-lanllm",
        "builder-lanllm-storage-landns",
        "training"
      ],
      "description": "Product-facing appliance profile selected for this installation."
    },
    "applianceName": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
      "description": "Product LAN instance label; FQDN is applianceName.dnsZone."
    },
    "dnsZone": {
      "type": "string",
      "minLength": 3,
      "description": "LAN DNS zone for this appliance identity (default appliance.internal)."
    },
    "components": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "k3sVersion",
        "chartVersion"
      ],
      "properties": {
        "k3sVersion": {
          "type": "string",
          "minLength": 1
        },
        "chartVersion": {
          "type": "string",
          "minLength": 1
        },
        "artifactServerVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Installed artifact server version when the artifact capability is enabled."
        },
        "dnsVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Installed CoreDNS version when the dns capability is enabled."
        },
        "inferenceVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Installed inference runtime version when the inference capability is enabled."
        },
        "videoVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Installed video runtime version when the video capability is enabled."
        },
        "metadataVersion": {
          "type": "string",
          "minLength": 1,
          "description": "Installed base appliance metadata-bundle version (X.Y.Z.N)."
        },
        "metadataDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$",
          "description": "Digest of the staged appliance metadata-bundle archive."
        }
      }
    },
    "k3sOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owned",
        "ownerApplianceVersion"
      ],
      "properties": {
        "owned": {
          "const": true
        },
        "ownerApplianceVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "lastOperation": {
      "$ref": "#/$defs/operation"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "status",
        "transactionId",
        "startedAt"
      ],
      "properties": {
        "type": {
          "enum": [
            "install",
            "upgrade",
            "repair",
            "backup",
            "restore",
            "uninstall",
            "factory-reset"
          ]
        },
        "status": {
          "enum": [
            "in-progress",
            "completed",
            "failed",
            "rolled-back"
          ]
        },
        "transactionId": {
          "type": "string",
          "minLength": 1
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "sourceVersion": {
          "type": "string",
          "description": "Set for upgrade operations: the version upgraded from."
        },
        "targetVersion": {
          "type": "string",
          "description": "Set for upgrade operations: the version upgraded to."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "completedAt"
            ]
          }
        }
      ]
    }
  }
}
