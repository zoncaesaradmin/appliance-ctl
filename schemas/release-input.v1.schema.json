{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appliance-release/schemas/release-input.v1.schema.json",
  "title": "ReleaseInput",
  "description": "Signed, immutable product input set produced by the private appliance-code repository and consumed by release intake.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "codeVersion",
    "releaseId",
    "generatedAt",
    "artifacts",
    "compatibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "codeVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "Sanitized appliance-code repo identity that produced this release-input set, for example a release tag, git describe value, or commit SHA."
    },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "description": "Unique, stable identifier for this candidate input set, e.g. a build UUID."
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlaneImage",
        "uiImage",
        "hostAgentImage",
        "hostAgentBinary",
        "applianceChart",
        "artifactServerImage",
        "artifactServerChart",
        "dnsImage",
        "dnsChart",
        "metadataBundle",
        "configurationSchema",
        "compatibility",
        "checksums",
        "sbom",
        "provenance",
        "notices",
        "tests"
      ],
      "properties": {
        "controlPlaneImage": { "$ref": "#/$defs/artifact" },
        "uiImage": { "$ref": "#/$defs/artifact" },
        "hostAgentImage": { "$ref": "#/$defs/artifact" },
        "hostAgentBinary": { "$ref": "#/$defs/artifact" },
        "hostPackages": {
          "$ref": "#/$defs/artifactDirectory",
          "description": "Offline host package directory carrying bundled operating-system packages required by installer-owned host capabilities such as mDNS and management WiFi AP."
        },
        "applianceChart": { "$ref": "#/$defs/artifact" },
        "artifactServerImage": { "$ref": "#/$defs/artifact" },
        "artifactServerChart": { "$ref": "#/$defs/artifact" },
        "dnsImage": { "$ref": "#/$defs/artifact" },
        "dnsChart": { "$ref": "#/$defs/artifact" },
        "inferenceRuntimeImage": { "$ref": "#/$defs/artifact" },
        "inferenceChart": { "$ref": "#/$defs/artifact" },
        "videoRuntimeImage": { "$ref": "#/$defs/artifact" },
        "videoChart": { "$ref": "#/$defs/artifact" },
        "metadataBundle": {
          "$ref": "#/$defs/artifact",
          "description": "Signed appliance metadata-bundle archive (appliance-metadata-bundle-X.Y.Z.N.tar.zst)."
        },
        "messageBrokerImage": { "$ref": "#/$defs/artifact", "description": "Pinned NATS JetStream OCI image archive." },
        "messageBrokerChart": { "$ref": "#/$defs/artifact", "description": "Dedicated always-on message broker chart." },
        "configurationSchema": { "$ref": "#/$defs/artifact" },
        "compatibility": { "$ref": "#/$defs/artifact" },
        "checksums": { "$ref": "#/$defs/artifact" },
        "sbom": { "$ref": "#/$defs/artifactDirectory" },
        "provenance": { "$ref": "#/$defs/artifactDirectory" },
        "notices": { "$ref": "#/$defs/artifactDirectory" },
        "tests": { "$ref": "#/$defs/artifactDirectory" },
        "workflowsChart": { "$ref": "#/$defs/artifact" },
        "workflowsCRDs": { "$ref": "#/$defs/artifactDirectory" },
        "workflowControllerImage": { "$ref": "#/$defs/artifact" },
        "workflowExecutorImage": { "$ref": "#/$defs/artifact" },
        "extraOCIImages": {
          "type": "array",
          "items": { "$ref": "#/$defs/artifact" },
          "description": "Additional pinned OCI image archives required by optional appliance capabilities, such as builder task images."
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["k3sVersion", "chartVersion", "artifactServerVersion", "dnsVersion"],
      "properties": {
        "k3sVersion": { "type": "string", "minLength": 1 },
        "chartVersion": { "type": "string", "minLength": 1 },
        "artifactServerVersion": { "type": "string", "minLength": 1 },
        "dnsVersion": { "type": "string", "minLength": 1 },
        "inferenceVersion": { "type": "string", "minLength": 1 },
        "videoVersion": { "type": "string", "minLength": 1 },
        "workflowsVersion": { "type": "string", "minLength": 1 },
        "supportedUpgradeSources": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Product versions this release is permitted to upgrade from."
        }
      }
    },
    "vulnerabilityExceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason", "expiresAt", "signedBy"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "expiresAt": { "type": "string", "format": "date-time" },
          "signedBy": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest", "sizeBytes"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "digest": { "$ref": "#/$defs/digest" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "signature": { "type": "string", "minLength": 1 },
        "imageReference": { "type": "string", "minLength": 1 }
      }
    },
    "artifactDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "manifestDigest"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "manifestDigest": {
          "$ref": "#/$defs/digest",
          "description": "Digest of the directory's own file listing/manifest, binding its contents."
        }
      }
    }
  }
}
